# cp .env.example .env and fill in your Databricks workspace details.
# Get these from your Databricks SQL warehouse: Connection details tab.
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Airflow 3 signs internal execution-API calls with this. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=change-me-to-a-random-secret

# Optional overrides (defaults shown):
DATABRICKS_CATALOG=zomato
DATABRICKS_SCHEMA=landing
DBT_THREADS=4

# S3 bucket the landing COPY INTO statements read raw CSVs from.
S3_BUCKET=zomato-ai-dev

# Used by ai/enrich_reviews.py (review sentiment enrichment task) and ai/connections.py.
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_MODEL_NAME=openai/gpt-oss-120b
